# Copy this file to .env for local development, then add your own API key.
# Never commit .env or put credentials in source code.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional: set AI_PROVIDER=gemini and provide GEMINI_API_KEY to use Gemini instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DATABASE_PATH=data/content_studio.db
MEDIA_STORAGE_PATH=data/generated_images
LOG_LEVEL=INFO

# Leave blank to use the safe defaults in content_studio/config.py.
RSS_FEEDS=
RSS_TIMEOUT_SECONDS=12
REQUEST_TIMEOUT_SECONDS=20
MAX_RESEARCH_RESULTS=6
BINANCE_MARKET_DATA_ENABLED=true
